{
  "manifest_version": 3,
  "name": "Meta Automator + 9router Jev",
  "version": "0.1.0",
  "description": "Scaffold MV3 extension for Meta AI queue automation and 9router Jev decisions",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://*.meta.ai/*",
    "https://9router.bangkhan.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://9router.bangkhan.com;"
  }
}
